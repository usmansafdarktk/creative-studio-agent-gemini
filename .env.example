# Google Cloud project / Vertex AI location (defaults shown)
GOOGLE_CLOUD_PROJECT=koc-dev-app-falcon-0
GOOGLE_CLOUD_LOCATION=global

# Models (override to experiment)
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_FAST_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Auth: locally the app uses `gcloud auth print-access-token`.
# Set to "adc" to use Application Default Credentials instead (automatic on Cloud Run).
# GOOGLE_AUTH_MODE=adc
